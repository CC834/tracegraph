# Synthetic demo mode is the safe default.
TRACEGRAPH_MODE=demo

# For local connected mode, uncomment one read-only URL.
# TRACEGRAPH_MODE=connected
# TRACEGRAPH_DATABASE_URL=sqlite:////absolute/path/to/demo.sqlite3
# TRACEGRAPH_DATABASE_URL=postgresql+psycopg://readonly_user:password@127.0.0.1/database

TRACEGRAPH_STATEMENT_TIMEOUT_MS=5000
TRACEGRAPH_MAX_DEPTH=4
TRACEGRAPH_MAX_ROWS_PER_TABLE=100
TRACEGRAPH_MAX_NODES=1000
# TRACEGRAPH_REDACTED_COLUMNS=email,phone_number

